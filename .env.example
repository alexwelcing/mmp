# MMP (Autonomous AI Director) — Environment Variables
#
# Copy this file to `.env` and fill in your own values.
# In production, inject secrets via GCP Secret Manager or Kubernetes Secrets.
#
# For LOCAL development, run `make contracts-local` and then:
#   export $(cat .env.contracts | xargs)
# to populate the contract addresses automatically.

# ------------------------------------------------------------------
# GCP (ignored in local mode)
# ------------------------------------------------------------------
GCP_PROJECT_ID=local-dev
GCP_REGION=us-central1

# ------------------------------------------------------------------
# Pub/Sub (bypassed in local mode via /generate endpoint)
# ------------------------------------------------------------------
PUBSUB_TOPIC=asset-generation-requests-local
PUBSUB_SUBSCRIPTION=asset-generation-requests-sub-local
PUBSUB_STATUS_TOPIC=

# ------------------------------------------------------------------
# ComfyUI Worker
# ------------------------------------------------------------------
# Native mode:   http://localhost:8188
# Docker mode:   http://comfyui:8188  (when AI Director is also in Docker)
COMFYUI_ENDPOINT=http://localhost:8188
COMFYUI_TIMEOUT_SECONDS=120
COMFYUI_WORKFLOWS_DIR=./services/comfyui-worker/workflows
COMFYUI_DRAFT_COUNT=4

# ------------------------------------------------------------------
# Audio
# ------------------------------------------------------------------
AUDIO_MODEL=moshi
AUDIO_ENDPOINT=http://localhost:9000
# AUDIO_ENDPOINT=http://audio:9000  # Use this when AI Director is inside Docker

# ------------------------------------------------------------------
# ReSplat (requires CUDA 12.8 GPU)
# ------------------------------------------------------------------
USE_RESPLAT_FOR_3D=false
RESPLAT_ENDPOINT=http://localhost:9001
RESPLAT_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------
# Web3 / Base L2
# ------------------------------------------------------------------
# Local Hardhat node defaults (set automatically by deploy-local.ts):
# BASE_RPC_URL=http://localhost:8545
# BUNDLER_URL=http://localhost:8545
#
# Base Sepolia defaults:
BASE_RPC_URL=https://sepolia.base.org
BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc

# Contract addresses — populated automatically by `make contracts-local`
CHARACTER_NFT_ADDRESS=0x0000000000000000000000000000000000000000
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
SPLITS_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Hardhat Account #1 private key (safe for local dev only).
# This is the second account from `npx hardhat node`.
AI_DIRECTOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ------------------------------------------------------------------
# Service
# ------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=20
CORS_ALLOW_ORIGINS=*
